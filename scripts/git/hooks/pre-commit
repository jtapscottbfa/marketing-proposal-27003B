#!/usr/bin/env bash
# ══════════════════════════════════════════════════════════════════════════════
# scripts/git/hooks/pre-commit
#
# Pre-commit hook: runs lightweight checks on staged Markdown files.
# Warns (does not block) on:
#   1. Unfilled PLACEHOLDER tokens in staged narrative files
#   2. Markdown files with no content beyond the YAML front matter
#
# INSTALL:
#   cp scripts/git/hooks/pre-commit .git/hooks/pre-commit
#   chmod +x .git/hooks/pre-commit
#
# Or use the install script:
#   bash scripts/git/hooks/install_hooks.sh
# ══════════════════════════════════════════════════════════════════════════════

set -euo pipefail

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
RESET='\033[0m'

WARNINGS=0
ERRORS=0

# ── Get staged files ──────────────────────────────────────────────────────────
STAGED_MD=$(git diff --cached --name-only --diff-filter=ACM | grep '\.md$' || true)
STAGED_SH=$(git diff --cached --name-only --diff-filter=ACM | grep '\.sh$' || true)

if [ -z "$STAGED_MD" ] && [ -z "$STAGED_SH" ]; then
  exit 0
fi

echo "🔍 Pre-commit: checking staged files..."

# ── Check 0: shellcheck on staged shell scripts ───────────────────────────────
if [ -n "$STAGED_SH" ]; then
  if command -v shellcheck &>/dev/null; then
    for file in $STAGED_SH; do
      if shellcheck "$file"; then
        echo -e "  ${GREEN}✔ shellcheck passed:${RESET} $file"
      else
        echo -e "  ${RED}✖ shellcheck failed:${RESET} $file"
        ERRORS=$((ERRORS + 1))
      fi
    done
  else
    echo -e "  ${YELLOW}⚠ shellcheck not installed — skipping shell script checks${RESET}"
    echo -e "    Install: scoop install shellcheck / choco install shellcheck"
    WARNINGS=$((WARNINGS + 1))
  fi
fi

# ── Check 1: PLACEHOLDER tokens in narrative volumes ─────────────────────────
NARRATIVE_VOLUMES="01_executive_summary 02_technical_volume 03_management_volume 04_past_performance 05_price_volume"

for file in $STAGED_MD; do
  # Only check files in narrative volume folders
  in_volume=false
  for vol in $NARRATIVE_VOLUMES; do
    if [[ "$file" == "$vol"/* ]]; then
      in_volume=true
      break
    fi
  done

  if $in_volume; then
    placeholder_count=$(grep -c "PLACEHOLDER" "$file" 2>/dev/null || true)
    if [ "$placeholder_count" -gt 0 ]; then
      echo -e "  ${YELLOW}⚠ PLACEHOLDER WARNING:${RESET} $file"
      echo -e "    ${placeholder_count} unfilled PLACEHOLDER(s) remain"
      WARNINGS=$((WARNINGS + 1))
    fi
  fi
done

# ── Check 2: Empty narrative files (only front matter, no body) ───────────────
for file in $STAGED_MD; do
  if [[ "$file" == 0[1-5]_*/*.md ]]; then
    # Strip YAML front matter (between --- delimiters) and count body lines
    body_lines=$(awk '/^---/{if(++c==2) found=1; next} found' "$file" 2>/dev/null | grep -vc '^\s*$' || true)
    if [ "$body_lines" -eq 0 ]; then
      echo -e "  ${YELLOW}⚠ EMPTY SECTION:${RESET} $file has no body content"
      WARNINGS=$((WARNINGS + 1))
    fi
  fi
done

# ── Check 3: compliance_matrix.md has no rows with unchecked boxes ────────────
# (advisory only — surfaced here as a reminder)
if echo "$STAGED_MD" | grep -q "compliance_matrix.md"; then
  unchecked=$(grep -c '| ☐ |' compliance_matrix.md 2>/dev/null || true)
  if [ "$unchecked" -gt 0 ]; then
    echo -e "  ${YELLOW}⚠ COMPLIANCE MATRIX:${RESET} $unchecked requirement(s) not yet marked compliant"
    WARNINGS=$((WARNINGS + 1))
  fi
fi

# ── Summary ───────────────────────────────────────────────────────────────────
echo ""
if [ "$ERRORS" -gt 0 ]; then
  echo -e "${RED}✖ Pre-commit: $ERRORS error(s) — commit blocked${RESET}"
  exit 1
elif [ "$WARNINGS" -gt 0 ]; then
  echo -e "${YELLOW}⚠ Pre-commit: $WARNINGS warning(s) — commit allowed but review recommended${RESET}"
  echo -e "  To skip these checks: ${YELLOW}git commit --no-verify${RESET}"
  exit 0
else
  echo -e "${GREEN}✔ Pre-commit checks passed${RESET}"
  exit 0
fi
